# Test Environment Configuration
NODE_ENV=test

# Server Configuration
PORT=3002
HOST=0.0.0.0

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Database
DATABASE_URL="postgresql://socialmedia:123456@localhost:5432/social_network_test?schema=public"

# JWT Configuration
JWT_SECRET=test-secret-key-for-testing-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=24h

# Cloudinary (valores de prueba)
CLOUDINARY_CLOUD_NAME=test-cloud-name
CLOUDINARY_API_KEY=test-api-key
CLOUDINARY_API_SECRET=test-api-secret

# Logging
LOG_LEVEL=error
