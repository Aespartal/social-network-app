enum Role {
  USER
  MODERATOR
  ADMIN
}

enum NotificationType {
  LIKE
  REPLY
  FOLLOW
  MENTION
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- USUARIOS ---
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  name      String
  googleId  String?  @unique
  avatar    String?
  bio       String?
  verified  Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  password  String?

  // Relaciones
  posts          Post[] // Incluye posts originales y respuestas (comentarios)
  likes          Like[]
  bookmarks      Bookmark[]
  following      Follow[]       @relation("UserFollowing")
  followers      Follow[]       @relation("UserFollowers")
  sessions       Session[]
  visitsMade     ProfileVisit[] @relation("VisitorRelation")
  visitsReceived ProfileVisit[] @relation("VisitedRelation")
  mentions       Mention[]
  recentSearches RecentSearch[]
  
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsIssued   Notification[] @relation("NotificationIssuer")

  role Role @default(USER)

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@map("sessions")
}

// --- CONTENIDO ---
model Post {
  id             String  @id @default(cuid())
  content        String  @db.Text
  image          String?
  authorId       String
  likesCount     Int     @default(0)
  repliesCount   Int     @default(0)
  bookmarksCount Int     @default(0)

  // Relación recursiva para Hilos/Comentarios
  parentId String?
  parent   Post?   @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Post[]  @relation("Thread")

  // Relaciones
  author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes     Like[]
  bookmarks Bookmark[]
  tags      PostTag[]
  mentions  Mention[]
  notifications Notification[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  country   String?
  city      String?

  // searchVector Unsupported("tsvector")? @map("search_vector")

  // Índices existentes
  @@index([parentId])
  @@index([authorId])

  // Nuevos índices compuestos para optimización
  @@index([authorId, createdAt, deletedAt])
  @@index([deletedAt, createdAt])
  @@index([deletedAt, parentId, createdAt])
  @@index([deletedAt, createdAt, likesCount])
  @@index([country, deletedAt, createdAt])
  @@index([city, deletedAt, createdAt])
  @@map("posts")
}

// --- INTERACCIONES ---
model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@index([postId, userId])
  @@index([userId, createdAt])
  @@map("likes")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@index([postId, userId])
  @@index([userId, createdAt])
  @@map("bookmarks")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

// --- TAXONOMÍA (HASHTAGS) ---
model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  posts     PostTag[]
  createdAt DateTime  @default(now())

  @@map("tags")
}

model PostTag {
  id     String @id @default(cuid())
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@map("post_tags")
}

model Mention {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("mentions")
}

// --- SOCIAL / MÉTRICAS ---
model ProfileVisit {
  id        String   @id @default(uuid())
  visitorId String
  visitedId String
  createdAt DateTime @default(now())

  visitor User @relation("VisitorRelation", fields: [visitorId], references: [id], onDelete: Cascade)
  visited User @relation("VisitedRelation", fields: [visitedId], references: [id], onDelete: Cascade)

  @@unique([visitorId, visitedId])
  @@index([visitedId])
  @@index([visitorId])
  @@map("profile_visits")
}

model RecentSearch {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@map("recent_searches")
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  recipientId String           // Usuario que recibe la notificación
  issuerId    String           // Usuario que provocó la notificación
  postId      String?          // Post relacionado (opcional)
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  issuer    User  @relation("NotificationIssuer", fields: [issuerId], references: [id], onDelete: Cascade)
  post      Post? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([recipientId])
  @@index([recipientId, read])
  @@index([createdAt])
  @@map("notifications")
}
