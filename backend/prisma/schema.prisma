generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String            @id @default(cuid())
  email                 String            @unique
  username              String            @unique
  name                  String
  avatar                String?
  bio                   String?
  verified              Boolean           @default(false)
  active                Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  password              String?
  googleId              String?           @unique
  role                  Role              @default(USER)
  currentLevel          Int               @default(1)
  totalXP               Int               @default(0)
  bookmarks             Bookmark[]
  following             Follow[]          @relation("UserFollowing")
  followers             Follow[]          @relation("UserFollowers")
  likes                 Like[]
  mentions              Mention[]
  notificationsIssued   Notification[]    @relation("NotificationIssuer")
  notificationsReceived Notification[]    @relation("NotificationRecipient")
  posts                 Post[]
  visitsReceived        ProfileVisit[]    @relation("VisitedRelation")
  visitsMade            ProfileVisit[]    @relation("VisitorRelation")
  recentSearches        RecentSearch[]
  sessions              Session[]
  userNodes             UserNode[]
  achievements          UserAchievement[]
  streaks               UserStreak[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Post {
  id             String                   @id @default(cuid())
  content        String
  image          String?
  authorId       String
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  parentId       String?
  deletedAt      DateTime?
  bookmarksCount Int                      @default(0)
  likesCount     Int                      @default(0)
  repliesCount   Int                      @default(0)
  readingTime    Int                      @default(1)
  city           String?
  country        String?
  searchVector   Unsupported("tsvector")? @map("search_vector")
  bookmarks      Bookmark[]
  likes          Like[]
  mentions       Mention[]
  notifications  Notification[]
  tags           PostTag[]
  author         User                     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent         Post?                    @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Post[]                   @relation("Thread")

  @@index([parentId])
  @@index([authorId])
  @@index([authorId, createdAt, deletedAt])
  @@index([deletedAt, createdAt])
  @@index([deletedAt, parentId, createdAt])
  @@index([deletedAt, createdAt, likesCount])
  @@index([country, deletedAt, createdAt])
  @@index([city, deletedAt, createdAt])
  @@map("posts")
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@index([postId, userId])
  @@index([userId, createdAt])
  @@map("likes")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@index([postId, userId])
  @@index([userId, createdAt])
  @@map("bookmarks")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  posts     PostTag[]
  auraNode  AuraNode?

  @@map("tags")
}

model AuraNode {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  icon        String?
  color       String?
  vibration   Float      @default(0)
  pulse       Float      @default(0)
  category    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  lastPulseAt DateTime   @default(now())
  tagId       String?    @unique
  tag         Tag?       @relation(fields: [tagId], references: [id])
  followers   UserNode[]

  @@index([vibration])
  @@index([pulse])
  @@map("aura_nodes")
}

model UserNode {
  userId    String
  nodeId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  node      AuraNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([userId, nodeId])
  @@map("user_nodes")
}

model PostTag {
  id     String @id @default(cuid())
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@map("post_tags")
}

model Mention {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("mentions")
}

model ProfileVisit {
  id        String   @id @default(uuid())
  visitorId String
  visitedId String
  createdAt DateTime @default(now())
  visited   User     @relation("VisitedRelation", fields: [visitedId], references: [id], onDelete: Cascade)
  visitor   User     @relation("VisitorRelation", fields: [visitorId], references: [id], onDelete: Cascade)

  @@unique([visitorId, visitedId])
  @@index([visitedId])
  @@index([visitorId])
  @@map("profile_visits")
}

model RecentSearch {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@map("recent_searches")
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  recipientId String
  issuerId    String
  postId      String?
  read        Boolean          @default(false)
  metadata    Json?
  createdAt   DateTime         @default(now())
  issuer      User             @relation("NotificationIssuer", fields: [issuerId], references: [id], onDelete: Cascade)
  post        Post?            @relation(fields: [postId], references: [id])
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([recipientId, read])
  @@index([createdAt])
  @@map("notifications")
}

model Achievement {
  id               String              @id @default(cuid())
  name             String
  description      String?
  slug             String              @unique
  category         AchievementCategory
  triggerEvent     String
  tierType         AchievementTierType
  iconEmoji        String?
  isHidden         Boolean             @default(false)
  announced        Boolean             @default(true)
  xpReward         Int                 @default(0)
  badgeSlug        String?
  profileFrameSlug String?
  createdAt        DateTime            @default(now())
  tiers            AchievementTier[]
  userProgress     UserAchievement[]

  @@map("achievements")
}

model AchievementTier {
  id               String      @id @default(cuid())
  achievementId    String
  tier             String
  threshold        Int
  xpReward         Int         @default(0)
  badgeSlug        String?
  profileFrameSlug String?
  requiresTier     String?
  achievement      Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([achievementId, tier])
  @@map("achievement_tiers")
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  tierAchieved  String?
  progress      Int         @default(0)
  completedAt   DateTime?
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId, tierAchieved])
  @@index([userId])
  @@map("user_achievements")
}

model UserStreak {
  id               String     @id @default(cuid())
  userId           String
  streakType       StreakType
  currentCount     Int        @default(0)
  longestCount     Int        @default(0)
  lastActivityAt   DateTime   @default(now())
  freezeTokens     Int        @default(1)
  streakShieldUsed Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, streakType])
  @@index([userId])
  @@map("user_streaks")
}

model Badge {
  id          String      @id @default(cuid())
  name        String
  description String?
  slug        String      @unique
  iconUrl     String?
  rarity      BadgeRarity @default(common)

  @@map("badges")
}

model ProfileFrame {
  id                    String      @id @default(cuid())
  name                  String
  slug                  String      @unique
  imageUrl              String
  rarity                BadgeRarity @default(common)
  requiresAchievementId String?

  @@map("profile_frames")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum NotificationType {
  LIKE
  REPLY
  FOLLOW
  MENTION
  ACHIEVEMENT
}

enum AchievementCategory {
  onboarding
  engagement
  content
  exploration
}

enum AchievementTierType {
  binary
  milestone
  progressive
  streak
}

enum StreakType {
  login
  post
  engagement
}

enum BadgeRarity {
  common
  rare
  epic
  legendary
}
